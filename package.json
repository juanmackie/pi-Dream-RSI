{
  "name": "pi-dream-rsi",
  "version": "2.0.0",
  "type": "module",
  "description": "Dream-RSI for pi: project self-assessment, bounded verifier-driven code improvement, and recursive exploration-policy optimization.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "dream-rsi",
    "discovery-tree",
    "replay-simulator",
    "policy-improvement",
    "coding-agent",
    "self-evaluation",
    "code-improvement",
    "benchmark-optimization"
  ],
  "license": "MIT",
  "author": {
    "name": "Juan Mackie",
    "url": "https://juanmackie.com"
  },
  "homepage": "https://juanmackie.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmackie/pi-Dream-RSI.git"
  },
  "bugs": {
    "url": "https://github.com/juanmackie/pi-Dream-RSI/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "reference": "https://pi.dev/packages"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "evaluators",
    "eval/bench.mjs",
    "eval/scenarios.json",
    "docs",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "node eval/bench.mjs --seeds 20000",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
