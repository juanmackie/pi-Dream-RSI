{
  "name": "pi-dream-rsi",
  "version": "3.0.2",
  "type": "module",
  "description": "Dream-RSI assessment and bounded autonomous improvement loop for pi",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "dream-rsi",
    "autonomous-improvement",
    "coding-agent",
    "self-evaluation",
    "benchmark-optimization"
  ],
  "license": "MIT",
  "author": {
    "name": "Juan Mackie",
    "url": "https://juanmackie.com"
  },
  "homepage": "https://juanmackie.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmackie/pi-Dream-RSI.git"
  },
  "bugs": {
    "url": "https://github.com/juanmackie/pi-Dream-RSI/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "reference": "https://pi.dev/packages"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "evaluators",
    "eval/bench.mjs",
    "eval/scenarios.json",
    "docs/autonomous-loop.md",
    "docs/method.md",
    "docs/adr",
    "examples",
    "README.md",
    "GLOSSARY.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "node eval/bench.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
